#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int main() 
{
    int n;
    if (scanf("%d", &n) != 1) return 0;
    int size = 2 * n - 1;
    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            int min_dist = i < j ? i : j;
            min_dist = min_dist < size - i - 1 ? min_dist : size - i - 1;
            min_dist = min_dist < size - j - 1 ? min_dist : size - j - 1;
            printf("%d ", n - min_dist);
        }
        printf("\n");
    }
    return 0;
}
