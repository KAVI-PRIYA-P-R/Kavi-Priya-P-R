#define HASH_SIZE 200003

typedef struct Node {
    long key;
    long value;
    struct Node* next;
} Node;

Node* singles[HASH_SIZE];
Node* pairs[HASH_SIZE];

unsigned int hash(long key) {
    unsigned long k = (unsigned long)key;
    k = ((k >> 16) ^ k) * 0x45d9f3b;
    k = ((k >> 16) ^ k) * 0x45d9f3b;
    k = (k >> 16) ^ k;
    return k % HASH_SIZE;
}

long get_val(Node** table, long key) {
    unsigned int h = hash(key);
    Node* curr = table[h];
    while (curr) {
        if (curr->key == key) {
            return curr->value;
        }
        curr = curr->next;
    }
    return 0;
}

void add_val(Node** table, long key, long val) {
    unsigned int h = hash(key);
    Node* curr = table[h];
    while (curr) {
        if (curr->key == key) {
            curr->value += val;
            return;
        }
        curr = curr->next;
    }
    Node* new_node = malloc(sizeof(Node));
    new_node->key = key;
    new_node->value = val;
    new_node->next = table[h];
    table[h] = new_node;
}

long countTriplets(int arr_count, long* arr, long r) {
    memset(singles, 0, sizeof(singles));
    memset(pairs, 0, sizeof(pairs));
    long total_triplets = 0;

    for (int i = 0; i < arr_count; i++) {
        long x = arr[i];
        
        total_triplets += get_val(pairs, x);
        
        long singles_count = get_val(singles, x);
        if (singles_count > 0) {
            add_val(pairs, x * r, singles_count);
        }
        
        add_val(singles, x * r, 1);
    }

    for (int i = 0; i < HASH_SIZE; i++) {
        Node* curr = singles[i];
        while (curr) {
            Node* tmp = curr;
            curr = curr->next;
            free(tmp);
        }
        curr = pairs[i];
        while (curr) {
            Node* tmp = curr;
            curr = curr->next;
            free(tmp);
        }
    }

    return total_triplets;
}

