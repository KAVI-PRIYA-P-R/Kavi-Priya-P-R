#include <stdlib.h>
int findMaxLength(int* nums, int numsSize) {
    int max_len = 0, curr_sum = 0;
    int map_size = 2 * numsSize + 1;
    int* hashmap = (int*)malloc(map_size * sizeof(int));
    for (int i = 0; i < map_size; i++) hashmap[i] = -2; 
    hashmap[0 + numsSize] = -1;                         
    for (int i = 0; i < numsSize; i++) {
        curr_sum += (nums[i] == 1) ? 1 : -1;
        int idx = curr_sum + numsSize;                  
        if (hashmap[idx] != -2) {
            int len = i - hashmap[idx];
            if (len > max_len) max_len = len;
        } else {
            hashmap[idx] = i;
        }
    }
    free(hashmap);
    return max_len;
}
